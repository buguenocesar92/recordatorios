{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kraftdo/recordatorios",
    "type": "project",
    "description": "MVP de recordatorios de obligaciones (KraftDo SpA): landing con lista de espera y doble opt-in.",
    "keywords": [
        "laravel",
        "filament",
        "kraftdo"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "bezhansalleh/filament-shield": "~4.2.0",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.15",
        "laravel/pennant": "^1.26",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.34",
        "sentry/sentry-laravel": "^4.26",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-csp": "^3.28"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "^5.0",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-livewire": "^4.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php -r \"if (is_dir('.git')) { exec('git config core.hooksPath .githooks'); }\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "post-install-cmd": [
            "@php -r \"if (is_dir('.git')) { exec('git config core.hooksPath .githooks'); }\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
